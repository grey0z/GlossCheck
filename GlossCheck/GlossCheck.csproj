<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <!-- EziMOTIONPlusE.dll và NGComm.dll là bản x64 => tiến trình bắt buộc x64 -->
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>GlossCheck</RootNamespace>
    <AssemblyName>GlossCheck</AssemblyName>
    <Nullable>disable</Nullable>
    <AssemblyTitle>GlossCheck - máy đo độ bóng 2 jig</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- DLL native: chép cạnh file exe để DllImport tìm thấy -->
    <None Include="Lib\x64\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
